# Fill in the actual Ubuntu host and NAS values before using Compose.
DATAMARK_HOST=
DATAMARK_BIND_IP=
# Default internal HTTPS port is 443. Set both values for a manual 10443 run.
DATAMARK_HTTPS_PORT=443
DATAMARK_ORIGIN_PORT_SUFFIX=
DATAMARK_HOME=
DATAMARK_NAS_MOUNT=
DATAMARK_WEB_IMAGE_TAG=
# Enable shared task management for NAS; data persists under DATAMARK_HOME/state/tasks.
DATAMARK_TASKS_ENABLED=0
# This deployment is LAN-only. Public S3 settings belong to a separate deployment.
