# Fill in the actual Ubuntu host and NAS values before using Compose.
DATAMARK_HOST=
DATAMARK_BIND_IP=
DATAMARK_HOME=
DATAMARK_NAS_MOUNT=
DATAMARK_WEB_IMAGE_TAG=
# Set all three only after DNS-only resolution, inbound TCP 10443, and the DNS API token are ready.
DATAMARK_PUBLIC_ORIGIN=
# Example: https://api-annotate.reltydynamic.com:10443
DATAMARK_PUBLIC_API_ORIGIN=
DATAMARK_PUBLIC_BIND_IP=
