ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --chmod=0444 backend/public_setup.py /app/backend/public_setup.py
COPY --chmod=0444 backend/shared_accounts.py /app/backend/shared_accounts.py
COPY --chmod=0444 backend/test_public_setup.py /app/backend/test_public_setup.py
COPY --chmod=0444 backend/test_shared_accounts.py /app/backend/test_shared_accounts.py
CMD ["/opt/venv/bin/python", "-m", "uvicorn", "backend.public_setup:create_app", "--factory", "--host", "0.0.0.0", "--port", "8765"]
