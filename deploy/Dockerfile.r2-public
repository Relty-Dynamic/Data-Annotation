ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY requirements.lock.txt /app/requirements.lock.txt
RUN /opt/venv/bin/python -m pip install --no-cache-dir --timeout 30 --retries 2 -r /app/requirements.lock.txt
COPY backend /app/backend
COPY launch.py /app/launch.py
COPY deploy /app/deploy
RUN chmod -R a+rX /app/backend /app/deploy /app/launch.py
USER 1000:1000
CMD ["/opt/venv/bin/python", "-m", "uvicorn", "backend.public_setup:create_app", "--factory", "--host", "0.0.0.0", "--port", "8765"]
